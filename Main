local function getItemRarityInfo(itemName)
    itemName = string.lower(itemName)
    if string.find(itemName, "legendary") or string.find(itemName, "mythic") or string.find(itemName, "godly") or string.find(itemName, "dragon") or string.find(itemName, "secret") then
        return "Legendary", Color3.fromRGB(255, 215, 0), 1
    elseif string.find(itemName, "epic") or string.find(itemName, "rare") or string.find(itemName, "diamond") or string.find(itemName, "purple") then
        return "Epic", Color3.fromRGB(170, 0, 255), 2
    elseif string.find(itemName, "uncommon") or string.find(itemName, "common") or string.find(itemName, "blue") or string.find(itemName, "iron") then
 
