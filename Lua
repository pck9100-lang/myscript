-- ฟังก์ชันหาเป้าหมายที่อยู่ภายในรัศมี FOV จริงๆ เท่านั้น
local function getClosestTargetInFOV(partName)
    local target = nil
    local shortestDist = aimbotFovRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(partName) and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local part = plr.Character[partName]
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                local dist = (screenPos2D - screenCenter).Magnitude
                if dist <= aimbotFovRadius and dist < shortestDist then
                    shortestDist = dist
                    target = part
                end
            end
        end
    end
    return target
end

-- 4. Aimbot แบบไม่ล็อคกล้อง (แสดงเส้นชี้เป้าเฉพาะคนที่อยู่ในวง FOV)
local aimLineEnabled = false
RunService.RenderStepped:Connect(function()
    if aimLineEnabled then
        local targetPart = getClosestTargetInFOV("Head")
        if targetPart then
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                AimLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                AimLine.To = Vector2.new(screenPos.X, screenPos.Y)
                AimLine.Visible = true
            else
                AimLine.Visible = false
            end
        else
            AimLine.Visible = false
        end
    else
        AimLine.Visible = false
    end
end)

createToggle("แสดงเส้นเล็งเป้าในวง FOV (Aim Line)", function(enabled)
    aimLineEnabled = enabled
end)

