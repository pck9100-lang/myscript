-- 2. มองสิ่งของ/อุปกรณ์ที่สวมใส่อยู่เป็นรูปภาพ (Equipped Items Icon ESP)
local itemEspEnabled = false
RunService.RenderStepped:Connect(function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local head = plr.Character.Head
            local itemBillboard = head:FindFirstChild("MS_ItemESP")
            
            if itemEspEnabled then
                if not itemBillboard then
                    itemBillboard = Instance.new("BillboardGui")
                    itemBillboard.Name = "MS_ItemESP"
                    itemBillboard.Size = UDim2.new(0, 120, 0, 40)
                    itemBillboard.StudsOffset = Vector3.new(0, 3.8, 0)
                    itemBillboard.AlwaysOnTop = true
                    itemBillboard.Parent = head

                    local iconHolder = Instance.new("UIListLayout")
                    iconHolder.Parent = itemBillboard
                    iconHolder.FillDirection = Enum.FillDirection.Horizontal
                    iconHolder.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    iconHolder.SortOrder = Enum.SortOrder.LayoutOrder
                    iconHolder.Padding = UDim.new(0, 4)
                end

                -- เคลียร์ไอคอนเก่าเพื่ออัปเดตใหม่แบบเรียลไทม์
                for _, child in pairs(itemBillboard:GetChildren()) do
                    if child:IsA("ImageLabel") then
                        child:Destroy()
                    end
                end

                -- ตรวจสอบหา Tool ที่ถืออยู่ หรือ Accessory ที่สวมใส่
                local itemsFound = {}
                
                -- ตรวจหา Tool ใน Character
                for _, obj in pairs(plr.Character:GetChildren()) do
                    if obj:IsA("Tool") then
                        table.insert(itemsFound, obj)
                    end
                end

                -- ตรวจหา BackPack (อาวุธ/ไอเทมหลักที่ถือพก)
                if plr:FindFirstChild("Backpack") then
                    for _, obj in pairs(plr.Backpack:GetChildren()) do
                        if obj:IsA("Tool") then
                            table.insert(itemsFound, obj)
                        end
                    end
                end

                -- สร้าง ImageLabel สำหรับแสดงรูปภาพไอเทม
                local count = 0
                for _, tool in pairs(itemsFound) do
                    if count < 3 then -- จำกัดแสดงผลสูงสุด 3 ชิ้นเพื่อไม่ให้บังจอ
                        local assetId = "rbxassetid://0" -- ค่าไอดีเริ่มต้น
                        if tool:FindFirstChild("TextureId") and tool.TextureId ~= "" then
                            assetId = tool.TextureId
                        elseif tool:FindFirstChild("Image") and tool.Image ~= "" then
                            assetId = tool.Image
                        end

                        local imgLabel = Instance.new("ImageLabel")
                        imgLabel.Parent = itemBillboard
                        imgLabel.BackgroundTransparency = 1
                        imgLabel.Size = UDim2.new(0, 32, 0, 32)
                        imgLabel.Image = assetId

                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(0, 6)
                        corner.Parent = imgLabel

                        local stroke = Instance.new("UIStroke")
                        stroke.Color = Color3.fromRGB(180, 130, 255)
                        stroke.Thickness = 1.2
                        stroke.Parent = imgLabel

                        count = count + 1
                    end
                end

                itemBillboard.Enabled = true
            else
                if itemBillboard then itemBillboard.Enabled = false end
            end
        end
    end
end)

createToggle("มองสิ่งของ/อุปกรณ์เป็นรูปภาพ (Item Icons)", function(enabled)
    itemEspEnabled = enabled
end)

