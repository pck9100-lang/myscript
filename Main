RunService.Stepped:Connect(function()
    if noclipEnabled then
        pcall(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end)

-- ================= Function 6: Player ESP (Rainbow Names) =================
local playerEspEnabled = false

local PlayerEspBtn = Instance.new("TextButton")
PlayerEspBtn.Name = "PlayerEspBtn"
PlayerEspBtn.Parent = ScrollFrame
PlayerEspBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
PlayerEspBtn.Position = UDim2.new(0, 15, 0, 210)
PlayerEspBtn.Size = UDim2.new(0, 265, 0, 30)
PlayerEspBtn.Font = Enum.Font.GothamBold
PlayerEspBtn.Text = "มองชื่อผู้เล่น (เรนโบว์): ปิด"
PlayerEspBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
PlayerEspBtn.TextSize = 12

PlayerEspBtn.MouseButton1Click:Connect(function()
    playerEspEnabled = not playerEspEnabled
    if playerEspEnabled then
        PlayerEspBtn.Text = "มองชื่อผู้เล่น (เรนโบว์): เปิด"
        PlayerEspBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        PlayerEspBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
    else
        PlayerEspBtn.Text = "มองชื่อผู้เล่น (เรนโบว์): ปิด"
        PlayerEspBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        PlayerEspBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") then
                if p.Character.Head:FindFirstChild("RainbowPlayerESP") then
                    p.Character.Head.RainbowPlayerESP:Destroy()
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if playerEspEnabled then
            pcall(function()
                local hue = tick() % 5 / 5
                local rainbowCol = Color3.fromHSV(hue, 1, 1)
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                        local head = p.Character.Head
                        local billboard = head:FindFirstChild("RainbowPlayerESP")
                        if not billboard then
                            billboard = Instance.new("BillboardGui")
                            billboard.Name = "RainbowPlayerESP"
                            billboard.Size = UDim2.new(0, 100, 0, 40)
                            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Parent = head

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Name = "NameLabel"
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.Font = Enum.Font.GothamBold
                            textLabel.TextSize = 14
                            textLabel.TextStrokeTransparency = 0.5
                            textLabel.Parent = billboard
                        end
                        if billboard:FindFirstChild("NameLabel") then
                            billboard.NameLabel.Text = p.Name
                            billboard.NameLabel.TextColor3 = rainbowCol
                        end
                    end
                end
            end)
        end
    end
end)

