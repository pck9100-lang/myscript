TitleBar.TextXAlignment = Enum.TextXAlignment.Left

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 8)
TitleCorner.Parent = TitleBar

ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- ================= Scrolling Frame =================
local ScrollFrame = Instance.new("ScrollingFrame")
ScrollFrame.Name = "ScrollFrame"
ScrollFrame.Parent = MainFrame
ScrollFrame.BackgroundTransparency = 1
ScrollFrame.Position = UDim2.new(0, 0, 0, 40)
ScrollFrame.Size = UDim2.new(1, 0, 1, -45)
ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 500)
ScrollFrame.ScrollBarThickness = 6
ScrollFrame.BorderSizePixel = 0

-- ================= Function 1: WalkSpeed =================
local speedEnabled = false
local currentSpeed = 50

local SpeedToggleBtn = Instance.new("TextButton")
SpeedToggleBtn.Name = "SpeedToggleBtn"
SpeedToggleBtn.Parent = ScrollFrame
SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SpeedToggleBtn.Position = UDim2.new(0, 15, 0, 10)
SpeedToggleBtn.Size = UDim2.new(0, 150, 0, 30)
SpeedToggleBtn.Font = Enum.Font.GothamBold
SpeedToggleBtn.Text = "ความเร็ว: ปิด"
SpeedToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
SpeedToggleBtn.TextSize = 12

SpeedToggleBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    if speedEnabled then
        SpeedToggleBtn.Text = "ความเร็ว: เปิด"
        SpeedToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
    else
        SpeedToggleBtn.Text = "ความเร็ว: ปิด"
        SpeedToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

local SpeedBox = Instance.new("TextBox")
SpeedBox.Name = "SpeedBox"
SpeedBox.Parent = ScrollFrame
SpeedBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpeedBox.Position = UDim2.new(0, 175, 0, 10)
SpeedBox.Size = UDim2.new(0, 105, 0, 30)
SpeedBox.Font = Enum.Font.Gotham
SpeedBox.PlaceholderText = "ความเร็ว"
SpeedBox.Text = "50"
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.TextSize = 12

SpeedBox.FocusLost:Connect(function()
    local num = tonumber(SpeedBox.Text)
    if num then currentSpeed = num else SpeedBox.Text = tostring(currentSpeed) end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if speedEnabled then
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    LocalPlayer.Character.Humanoid.WalkSpeed = currentSpeed
                end
            end)
        end
    end
end)

-- ================= Function 2: Infinite Jump =================
local infJumpEnabled = false

local InfJumpBtn = Instance.new("TextButton")
InfJumpBtn.Name = "InfJumpBtn"
InfJumpBtn.Parent = ScrollFrame
InfJumpBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
InfJumpBtn.Position = UDim2.new(0, 15, 0, 50)
InfJumpBtn.Size = UDim2.new(0, 265, 0, 30)
InfJumpBtn.Font = Enum.Font.GothamBold
InfJumpBtn.Text = "กระโดดไม่จำกัด: ปิด"
InfJumpBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
InfJumpBtn.TextSize = 12

InfJumpBtn.MouseButton1Click:Connect(function()
    infJumpEnabled = not infJumpEnabled
    if infJumpEnabled then
        InfJumpBtn.Text = "กระโดดไม่จำกัด: เปิด"
        InfJumpBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        InfJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
    else
        InfJumpBtn.Text = "กระโดดไม่จำกัด: ปิด"
        InfJumpBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        InfJumpBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end)

-- ================= Function 3: JumpPower / JumpHeight =================
local jumpPowerEnabled = false
local currentJumpPower = 100

local JumpPowerToggleBtn = Instance.new("TextButton")
JumpPowerToggleBtn.Name = "JumpPowerToggleBtn"
JumpPowerToggleBtn.Parent = ScrollFrame
JumpPowerToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
JumpPowerToggleBtn.Position = UDim2.new(0, 15, 0, 90)
JumpPowerToggleBtn.Size = UDim2.new(0, 150, 0, 30)
JumpPowerToggleBtn.Font = Enum.Font.GothamBold
JumpPowerToggleBtn.Text = "กระโดดสูง: ปิด"
JumpPowerToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
JumpPowerToggleBtn.TextSize = 12

JumpPowerToggleBtn.MouseButton1Click:Connect(function()
    jumpPowerEnabled = not jumpPowerEnabled
    if jumpPowerEnabled then
        JumpPowerToggleBtn.Text = "กระโดดสูง: เปิด"
        JumpPowerToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        JumpPowerToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
    else
        JumpPowerToggleBtn.Text = "กระโดดสูง: ปิด"
        JumpPowerToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        JumpPowerToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.JumpPower = 50
        end
    end
end)

local JumpPowerBox = Instance.new("TextBox")
JumpPowerBox.Name = "JumpPowerBox"
JumpPowerBox.Parent = ScrollFrame
JumpPowerBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
JumpPowerBox.Position = UDim2.new(0, 175, 0, 90)
JumpPowerBox.Size = UDim2.new(0, 105, 0, 30)
JumpPowerBox.Font = Enum.Font.Gotham
JumpPowerBox.PlaceholderText = "กระโดดสูง"
JumpPowerBox.Text = "100"
JumpPowerBox.TextColor3 = Color3.fromRGB(255, 255, 255)
JumpPowerBox.TextSize = 12

JumpPowerBox.FocusLost:Connect(function()
    local num = tonumber(JumpPowerBox.Text)
    if num then currentJumpPower = num else JumpPowerBox.Text = tostring(currentJumpPower) end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if jumpPowerEnabled then
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    local humanoid = LocalPlayer.Character.Humanoid
                    if humanoid.UseJumpPower then
                        humanoid.JumpPower = currentJumpPower
                    else
                        humanoid.JumpHeight = currentJumpPower / 3
                    end
                end
            end)
        end
    end
end)

-- ================= Function 4: Smooth Slow Fall =================
local slowFallEnabled = false
local bodyVelocity = nil

local SlowFallBtn = Instance.new("TextButton")
SlowFallBtn.Name = "SlowFallBtn"
SlowFallBtn.Parent = ScrollFrame
SlowFallBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SlowFallBtn.Position = UDim2.new(0, 15, 0, 130)
SlowFallBtn.Size = UDim2.new(0, 265, 0, 30)
SlowFallBtn.Font = Enum.Font.GothamBold
SlowFallBtn.Text = "ลอยตัวตกช้าๆ: ปิด"
SlowFallBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
SlowFallBtn.TextSize = 12

SlowFallBtn.MouseButton1Click:Connect(function()
    slowFallEnabled = not slowFallEnabled
    if slowFallEnabled then
        SlowFallBtn.Text = "ลอยตัวตกช้าๆ: เปิด"
        SlowFallBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        SlowFallBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
    else
        SlowFallBtn.Text = "ลอยตัวตกช้าๆ: ปิด"
        SlowFallBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        SlowFallBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local humanoid = LocalPlayer.Character.Humanoid
                
                if slowFallEnabled then
                    if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
                        if not hrp:FindFirstChild("SmoothSlowFall") then
                            bodyVelocity = Instance.new("BodyVelocity")
                            bodyVelocity.Name = "SmoothSlowFall"
                            bodyVelocity.MaxForce = Vector3.new(0, 50000, 0)
                            bodyVelocity.Velocity = Vector3.new(0, -12, 0)
                            bodyVelocity.Parent = hrp
                        end
                    else
                        if hrp:FindFirstChild("SmoothSlowFall") then
                            hrp.SmoothSlowFall:Destroy()
                        end
                    end
                else
                    if hrp:FindFirstChild("SmoothSlowFall") then
                        hrp.SmoothSlowFall:Destroy()
                        bodyVelocity = nil
                    end
                end
            end
        end)
    end
end)

