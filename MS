local function updatePlayerList()
    for _, child in pairs(WLScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Parent = WLScroll
            pBtn.BackgroundColor3 = Color3.fromRGB(30, 22, 45)
            pBtn.Size = UDim2.new(1, 0, 0, 32)
            pBtn.Font = Enum.Font.GothamMedium
            pBtn.Text = "   " .. plr.Name .. " (DO NOT LOCK: OFF)"
            pBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            pBtn.TextSize = 12
            pBtn.TextXAlignment = Enum.TextXAlignment.Left

            local pCor = Instance.new("UICorner")
            pCor.CornerRadius = UDim.new(0, 6)
            pCor.Parent = pBtn

            local isIgnored = table.find(WhitelistTable, plr.Name) ~= nil
            if isIgnored then
                pBtn.Text = "   " .. plr.Name .. " (DO NOT LOCK: ON)"
                pBtn.TextColor3 = Color3.fromRGB(180, 130, 255)
                pBtn.BackgroundColor3 = Color3.fromRGB(45, 30, 75)
            end

            pBtn.MouseButton1Click:Connect(function()
                local idx = table.find(WhitelistTable, plr.Name)
                if idx then
                    table.remove(WhitelistTable, idx)
                    pBtn.Text = "   " .. plr.Name .. " (DO NOT LOCK: OFF)"
                    pBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                    pBtn.BackgroundColor3 = Color3.fromRGB(30, 22, 45)
                else
                    table.insert(WhitelistTable, plr.Name)
                    pBtn.Text = "   " .. plr.Name .. " (DO NOT LOCK: ON)"
                    pBtn.TextColor3 = Color3.fromRGB(180, 130, 255)
                    pBtn.BackgroundColor3 = Color3.fromRGB(45, 30, 75)
                end
            end)
        end
    end
    WLScroll.CanvasSize = UDim2.new(0, 0, 0, WLListLayout.AbsoluteContentSize.Y + 10)
end

